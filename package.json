    "@types/pg": "^8.23.1",
    "better-auth": "1.7.7",
    "docx": "^9.5.1",
    "dotenv": "17.2.3",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "redis": "^5.10.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.0",
