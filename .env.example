# AssignMe environment template — never commit real secrets.
DATABASE_URL="postgresql://assignme:assignme@localhost:5432/assignme"
REDIS_URL="redis://localhost:6379"
BETTER_AUTH_SECRET="change-me-min-32-chars"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Backblaze B2 (file storage). Endpoint looks like:
# https://s3.us-west-004.backblazeb2.com (region parsed from it).
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET="assignme-files"
B2_ENDPOINT=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
RESEND_API_KEY=""
APP_URL="http://localhost:3000"
EMAIL_FROM="AssignMe <noreply@assignme.app>"
